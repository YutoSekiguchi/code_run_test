FROM emscripten/emsdk:3.1.51

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install SDL2 port for Emscripten
RUN emcc --show-ports | grep -q SDL2 || echo "SDL2 port available"

# Set working directory
WORKDIR /app

# Pre-compile SDL2 to cache it
RUN echo '#include <SDL2/SDL.h>' > test.cpp && \
    echo 'int main() { SDL_Init(SDL_INIT_VIDEO); return 0; }' >> test.cpp && \
    em++ test.cpp -s USE_SDL=2 -o test.html && \
    rm test.cpp test.html test.js test.wasm

# Set environment for Emscripten
ENV EMSCRIPTEN=/emsdk/upstream/emscripten
ENV PATH="${EMSCRIPTEN}:${PATH}"